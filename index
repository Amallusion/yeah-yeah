<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sync It — Alternative Entertainment Café & Cultural Space</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-black: #171312;
            --gold: #B08A52;
            --gold-light: #D4AF37;
            --burgundy: #761F35;
            --ivory: #E8DCC5;
            --emerald: #25463E;
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Montserrat', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-black);
            color: var(--ivory);
            font-family: var(--font-sans);
            overflow-x: hidden;
            letter-spacing: 0.05em;
        }

        /* Art Deco Corner Ornament Utility */
        .deco-frame {
            position: relative;
            border: 1px solid var(--gold);
            padding: 2.5rem;
        }
        .deco-frame::before, .deco-frame::after {
            content: "";
            position: absolute;
            width: 12px;
            height: 12px;
            border: 1px solid var(--gold);
            background: var(--bg-black);
        }
        .deco-frame::before { top: -6px; left: -6px; }
        .deco-frame::after { bottom: -6px; right: -6px; }

        /* Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(23, 19, 18, 0.92);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(176, 138, 82, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 4rem;
        }

        .nav-logo {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.2em;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .nav-logo span {
            font-size: 0.7rem;
            font-family: var(--font-sans);
            letter-spacing: 0.3em;
            color: var(--ivory);
            border-left: 1px solid var(--gold);
            padding-left: 0.75rem;
        }

        nav ul {
            display: flex;
            gap: 2.5rem;
            list-style: none;
            align-items: center;
        }

        nav a {
            color: var(--ivory);
            text-decoration: none;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: color 0.3s ease;
            position: relative;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--gold);
            transition: width 0.3s ease;
        }

        nav a:hover {
            color: var(--gold);
        }

        nav a:hover::after {
            width: 100%;
        }

        .nav-cta {
            border: 1px solid var(--gold);
            padding: 0.6rem 1.5rem;
            color: var(--gold) !important;
            transition: all 0.3s ease;
        }

        .nav-cta:hover {
            background: var(--gold);
            color: var(--bg-black) !important;
        }
        .nav-cta::after { display: none !important; }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 10rem 2rem 5rem;
            position: relative;
            background: radial-gradient(circle at center, rgba(37, 70, 62, 0.25) 0%, rgba(23, 19, 18, 0.95) 80%);
        }

        .hero-sunburst {
            position: absolute;
            width: 600px;
            height: 600px;
            border: 1px solid rgba(176, 138, 82, 0.15);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        .hero-sunburst::before {
            content: '';
            position: absolute;
            inset: 20px;
            border: 1px dashed rgba(176, 138, 82, 0.2);
            border-radius: 50%;
        }

        .hero-emblem {
            font-size: 0.9rem;
            letter-spacing: 0.4em;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .hero-emblem::before, .hero-emblem::after {
            content: "◆";
            font-size: 0.6rem;
            color: var(--burgundy);
        }

        .hero h1 {
            font-family: var(--font-serif);
            font-size: clamp(3rem, 5.5vw, 5.5rem);
            font-weight: 300;
            line-height: 1.15;
            max-width: 1100px;
            margin-bottom: 2rem;
            color: var(--ivory);
        }

        .hero h1 em {
            font-style: italic;
            color: var(--gold);
        }

        .hero p {
            font-size: 1.1rem;
            max-width: 650px;
            color: rgba(232, 220, 197, 0.8);
            margin-bottom: 3rem;
            line-height: 1.6;
        }

        .btn-primary {
            display: inline-block;
            background: transparent;
            color: var(--ivory);
            border: 1px solid var(--gold);
            padding: 1.1rem 2.8rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            text-decoration: none;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--gold);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
            z-index: -1;
        }

        .btn-primary:hover {
            color: var(--bg-black);
            border-color: var(--gold);
        }

        .btn-primary:hover::before {
            transform: scaleX(1);
            transform-origin: left;
        }

        /* Divider */
        .section-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            margin: 5rem 0;
            opacity: 0.6;
        }

        .section-divider::before, .section-divider::after {
            content: '';
            height: 1px;
            width: 150px;
            background: var(--gold);
        }

        .section-divider span {
            color: var(--gold);
            font-size: 1.2rem;
        }

        /* About Section */
        .about {
            max-width: 1300px;
            margin: 0 auto;
            padding: 6rem 2rem;
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 5rem;
            align-items: center;
        }

        .about-visual {
            position: relative;
            height: 550px;
            border: 1px solid var(--gold);
            background: linear-gradient(135deg, var(--emerald), var(--bg-black));
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .about-visual::after {
            content: '';
            position: absolute;
            inset: 15px;
            border: 1px solid rgba(176, 138, 82, 0.4);
            pointer-events: none;
        }

        .about-graphic-text {
            font-family: var(--font-serif);
            font-size: 8rem;
            color: rgba(176, 138, 82, 0.08);
            position: absolute;
            font-style: italic;
            user-select: none;
        }

        .about-content h2 {
            font-family: var(--font-serif);
            font-size: 3rem;
            font-weight: 400;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            color: var(--gold);
        }

        .about-content p {
            font-size: 1rem;
            line-height: 1.8;
            color: rgba(232, 220, 197, 0.85);
            margin-bottom: 1.5rem;
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 2rem;
        }

        .tag {
            background: rgba(118, 31, 53, 0.3);
            border: 1px solid var(--burgundy);
            padding: 0.4rem 1rem;
            font-size: 0.75rem;
            letter-spacing: 0.15s;
            text-transform: uppercase;
            color: var(--ivory);
            border-radius: 50px;
        }

        /* Events Section */
        .events {
            max-width: 1300px;
            margin: 0 auto;
            padding: 6rem 2rem;
        }

        .section-header {
            text-align: center;
            margin-bottom: 5rem;
        }

        .section-header h2 {
            font-family: var(--font-serif);
            font-size: 3.5rem;
            font-weight: 300;
            color: var(--ivory);
            margin-bottom: 1rem;
        }

        .section-header p {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.3rem;
            font-size: 0.8rem;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
        }

        .event-card {
            background: linear-gradient(180deg, #1c1716 0%, #120f0e 100%);
            border: 1px solid rgba(176, 138, 82, 0.3);
            padding: 2.5rem 2rem;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 480px;
            transition: transform 0.4s ease, border-color 0.4s ease;
        }

        .event-card:hover {
            transform: translateY(-8px);
            border-color: var(--gold);
        }

        .event-date {
            font-size: 0.75rem;
            letter-spacing: 0.25rem;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .event-card h3 {
            font-family: var(--font-serif);
            font-size: 2rem;
            font-weight: 400;
            line-height: 1.2;
            margin-bottom: 1rem;
            color: var(--ivory);
        }

        .event-card p {
            font-size: 0.9rem;
            color: rgba(232, 220, 197, 0.7);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .event-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(176, 138, 82, 0.2);
            padding-top: 1.5rem;
        }

        .event-genre {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--burgundy);
            font-weight: 600;
        }

        .event-link {
            color: var(--gold);
            text-decoration: none;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: color 0.3s ease;
        }

        .event-link:hover {
            color: var(--ivory);
        }

        /* Gallery Section */
        .gallery {
            padding: 6rem 0;
            background: linear-gradient(180deg, var(--bg-black) 0%, #110e0d 100%);
        }

        .gallery-grid {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            grid-template-rows: 350px 350px;
            gap: 2rem;
        }

        .gallery-item {
            position: relative;
            border: 1px solid rgba(176, 138, 82, 0.3);
            overflow: hidden;
            background: var(--emerald);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gallery-item.tall {
            grid-row: span 2;
        }

        .gallery-item.wide {
            grid-column: span 2;
        }

        .gallery-placeholder-content {
            text-align: center;
            padding: 2rem;
            color: var(--ivory);
            font-family: var(--font-serif);
            font-size: 1.5rem;
            font-style: italic;
            background: rgba(23, 19, 18, 0.7);
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(176, 138, 82, 0.2);
            transition: all 0.5s ease;
        }

        .gallery-item:hover .gallery-placeholder-content {
            background: rgba(23, 19, 18, 0.3);
            letter-spacing: 0.1em;
            color: var(--gold);
        }

        /* Footer */
        footer {
            background: #0d0a09;
            border-top: 1px solid var(--gold);
            padding: 6rem 2rem 3rem;
            text-align: center;
            position: relative;
        }

        .footer-inner {
            max-width: 900px;
            margin: 0 auto;
        }

        .footer-logo {
            font-family: var(--font-serif);
            font-size: 2.5rem;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.3em;
            margin-bottom: 1.5rem;
        }

        .footer-tagline {
            font-size: 1rem;
            color: rgba(232, 220, 197, 0.7);
            margin-bottom: 3rem;
            letter-spacing: 0.2em;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 3rem;
            list-style: none;
            margin-bottom: 3rem;
        }

        .footer-links a {
            color: var(--ivory);
            text-decoration: none;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.2em;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--gold);
        }

        .footer-meta {
            border-top: 1px solid rgba(176, 138, 82, 0.2);
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.75rem;
            color: rgba(232, 220, 197, 0.5);
            letter-spacing: 0.15em;
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <header>
        <a href="#" class="nav-logo">
            Sync It <span>Cultural Space</span>
        </a>
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#events">Events</a></li>
                <li><a href="#gallery">Gallery</a></li>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#visit" class="nav-cta">Reserve</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-sunburst"></div>
        <div class="hero-emblem">Alternative Entertainment & Subculture Haven</div>
        <h1>Where cultures collide, and <em>worlds come together.</em></h1>
        <p>An unconventional space for music, art, creativity, and the beautifully unusual.</p>
        <a href="#events" class="btn-primary">Discover Sync It</a>
    </section>

    <div class="section-divider">
        <span>◆</span>
    </div>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="about-visual">
            <div class="about-graphic-text">SYNC</div>
            <div style="position: relative; z-index: 2; text-align: center; padding: 2rem;">
                <h3 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--gold); margin-bottom: 1rem;">Theatrical Maximalism</h3>
                <p style="color: var(--ivory); font-size: 0.95rem; max-width: 380px; line-height: 1.6;">Rooted in the spirit of Erté — elegance meeting the avant-garde. Designed for independent minds, late-night thinkers, and cultural collectors.</p>
            </div>
        </div>
        <div class="about-content">
            <h2>An Unconventional Sanctuary</h2>
            <p>Sync It is more than an entertainment café; it is a living canvas where underground music, radical art curation, and bohemian community converge.</p>
            <p>Away from sterile corporate lounges, our space embraces dramatic lighting, opulent Art Deco curves, velvet textures, and an electric atmosphere designed for those who march to a different rhythm.</p>
            <div class="tag-list">
                <span class="tag">Live Vinyl Sessions</span>
                <span class="tag">Art Salons</span>
                <span class="tag">Poetry & Noise</span>
                <span class="tag">Craft Elixirs</span>
            </div>
        </div>
    </section>

    <!-- Events Section -->
    <section id="events" class="events">
        <div class="section-header">
            <p>Curated Happenings</p>
            <h2>Theatrical Evenings & Salons</h2>
        </div>
        <div class="events-grid">
            <div class="event-card">
                <div>
                    <div class="event-date">Friday, Nov 20 • 9:00 PM</div>
                    <h3>Nocturnal Harmonies: Avant-Garde Strings</h3>
                    <p>An immersive acoustic journey featuring experimental neoclassical arrangements and smoky ambient jazz.</p>
                </div>
                <div class="event-footer">
                    <span class="event-genre">Live Music</span>
                    <a href="#" class="event-link">Details &rarr;</a>
                </div>
            </div>
            <div class="event-card">
                <div>
                    <div class="event-date">Saturday, Nov 28 • 7:30 PM</div>
                    <h3>The Subversive Canvas: Live Art Battle</h3>
                    <p>Four contemporary visual artists compete under dramatic chandelier light while underground electronic soundscapes play.</p>
                </div>
                <div class="event-footer">
                    <span class="event-genre">Art Exhibition</span>
                    <a href="#" class="event-link">Details &rarr;</a>
                </div>
            </div>
            <div class="event-card">
                <div>
                    <div class="event-date">Thursday, Dec 03 • 8:00 PM</div>
                    <h3>Poetry, Prose & Velvet Shadows</h3>
                    <p>An intimate spoken word open mic celebrating unconventional narratives, rebellion, and lyrical expression.</p>
                </div>
                <div class="event-footer">
                    <span class="event-genre">Literature</span>
                    <a href="#" class="event-link">Details &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="gallery">
        <div class="section-header" style="margin-bottom: 3rem;">
            <p>Visual Atmosphere</p>
            <h2>Glimpses of the Unusual</h2>
        </div>
        <div class="gallery-grid">
            <div class="gallery-item tall">
                <div class="gallery-placeholder-content">The Grand Main Lounge</div>
            </div>
            <div class="gallery-item">
                <div class="gallery-placeholder-content">Artisan Elixirs</div>
            </div>
            <div class="gallery-item">
                <div class="gallery-placeholder-content">Vinyl Archive</div>
            </div>
            <div class="gallery-item wide">
                <div class="gallery-placeholder-content">Late Night Salon & Performance Space</div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-inner">
            <div class="footer-logo">Sync It</div>
            <p class="footer-tagline">Where cultures collide, and worlds come together.</p>
            <ul class="footer-links">
                <li><a href="#">Instagram</a></li>
                <li><a href="#">Substack</a></li>
                <li><a href="#">Soundcloud</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
            <div class="footer-meta">
                <span>&copy; 2026 Sync It Cultural Space. All Rights Reserved.</span>
                <span>Dhahran, Eastern Province</span>
            </div>
        </div>
    </footer>

</body>
</html>
